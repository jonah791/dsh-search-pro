{
  "name": "dsh-search-pro",
  "version": "0.1.0",
  "description": "深度搜索插件：三层检索（表层多引擎/深网挖掘/Tor代理）+ 发现层（Common Crawl/crt.sh/站点爬取）+ 抽取层（附件→文本）+ 情报系统（监控/增量/推送）——工具清单见 plugin_inspect，不在文档写死数字（写死的必然漂移）",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "dsh-plugin.json"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"tests/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
